            <resolution>1</resolution>
            <min_angle>-2.35619449019</min_angle>
            <max_angle>2.35619449019</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.5</min>
          <max>20</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_laser.so" name="gazebo_ros_laser">
        <topicName>front/scan</topicName>
        <frameName>front_laser</frameName>
        <robotNamespace>/</robotNamespace>
      </plugin>
    </sensor>
  </gazebo>
  <link name="rear_sensor">
    <visual>
      <geometry>
        <mesh filename="package://arena_robots/robots/boxer/meshes/rear_sensor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <material name="Boxer_Black"/>
    </visual>
  </link>
  <joint name="rear_sensor_joint" type="fixed">
    <origin rpy="0.0 -0.0698131700798 3.141592653589793" xyz="-0.3404 0.0241 0.0779"/>
    <parent link="chassis_link"/>
    <child link="rear_sensor"/>
  </joint>
  <gazebo reference="rear_sensor">
    <material>Gazebo/Black</material>
    <turnGravityOff>true</turnGravityOff>
    <sensor name="rear_laser" type="gpu_lidar">
      <gz_frame_id>/rear_sensor</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>50</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>11</samples>
            <resolution>1</resolution>
            <min_angle>-0.6981317</min_angle>
            <max_angle>0.6981317</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>8</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_laser.so" name="gazebo_ros_laser">
        <topicName>rear/scan</topicName>
        <frameName>rear_sensor</frameName>
        <robotNamespace>/</robotNamespace>
      </plugin>
    </sensor>
  </gazebo>
  <link name="imu_sensor_link"/>
  <joint name="imu_sensor_link_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="imu_sensor_link"/>
  </joint>
  <gazebo reference="imu_sensor_link">
    <sensor name="imu_sensor" type="imu">
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>/imu_sensor_link</gz_frame_id>
    </sensor>
  </gazebo>
  <material name="aluminum">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <link name="front_realsense_mount_link"/>
  <joint name="front_realsense_mount_link_joint" type="fixed">
    <origin rpy="0.0 -0.257610597594 0.0" xyz="0.3524 0.0 0.0422"/>
    <parent link="chassis_link"/>
    <child link="front_realsense_mount_link"/>
  </joint>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="realsense_front_camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="front_realsense_mount_link"/>
    <child link="realsense_front_camera_bottom_screw_frame"/>
  </joint>
  <link name="realsense_front_camera_bottom_screw_frame"/>
  <joint name="realsense_front_camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
    <parent link="realsense_front_camera_bottom_screw_frame"/>
    <child link="realsense_front_camera_link"/>
  </joint>
  <link name="realsense_front_camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/>
      <geometry>
        <mesh filename="package://realsense2_description/meshes/d435.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera depth joints and links -->
  <joint name="realsense_front_camera_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="realsense_front_camera_link"/>
    <child link="realsense_front_camera_depth_frame"/>
  </joint>
  <link name="realsense_front_camera_depth_frame"/>
  <joint name="realsense_front_camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="realsense_front_camera_depth_frame"/>
    <child link="realsense_front_camera_depth_optical_frame"/>
  </joint>
  <link name="realsense_front_camera_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="realsense_front_camera_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="realsense_front_camera_link"/>
    <child link="realsense_front_camera_infra1_frame"/>
  </joint>
  <link name="realsense_front_camera_infra1_frame"/>
  <joint name="realsense_front_camera_infra1_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="realsense_front_camera_infra1_frame"/>
    <child link="realsense_front_camera_infra1_optical_frame"/>
  </joint>
  <link name="realsense_front_camera_infra1_optical_frame"/>
  <!-- camera right IR joints and links -->
  <joint name="realsense_front_camera_infra2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.05 0"/>
    <parent link="realsense_front_camera_link"/>
    <child link="realsense_front_camera_infra2_frame"/>
  </joint>
  <link name="realsense_front_camera_infra2_frame"/>
  <joint name="realsense_front_camera_infra2_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="realsense_front_camera_infra2_frame"/>
    <child link="realsense_front_camera_infra2_optical_frame"/>
  </joint>
  <link name="realsense_front_camera_infra2_optical_frame"/>
  <!-- camera color joints and links -->
  <joint name="realsense_front_camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.015 0"/>
    <parent link="realsense_front_camera_link"/>
    <child link="realsense_front_camera_color_frame"/>
  </joint>
  <link name="realsense_front_camera_color_frame"/>
  <joint name="realsense_front_camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="realsense_front_camera_color_frame"/>
    <child link="realsense_front_camera_color_optical_frame"/>
  </joint>
  <link name="realsense_front_camera_color_optical_frame"/>
  <gazebo reference="realsense_front_camera_depth_frame">
    <sensor name="realsense_front_camera" type="depth_camera">
      <gz_frame_id>/realsense_front_camera_depth_frame</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>front_realsense_mount_link/depth_image</topic>
      <camera>
        <camera_info_topic>front_realsense_mount_link/camera_info</camera_info_topic>
        <horizontal_fov>1.5184351666666667</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.105</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
